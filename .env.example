# Husker — variables d'environnement
# Copier en `.env` (gitignore) et adapter les valeurs : cp .env.example .env

# DB SQLite — requis (panic au démarrage si absent).
# Aussi utilisé à la COMPILATION par les macros sqlx::query_as! :
# la DB pointée doit exister et avoir les migrations appliquées.
DATABASE_URL=sqlite:husker.db

# Port d'écoute du serveur axum — optionnel (défaut : 8080).
PORT=8080

# Registries autorisés pour les `FROM` des Dockerfiles des apps déployées, séparés
# par des virgules — optionnel (défaut : docker.io seul, fail-closed).
# Vérifié entre le clone et le build, avant tout accès registry (HUSKER-15, ADR-019) :
#   registry hors liste            -> deploy REFUSÉ (HTTP 422)
#   base non pinnée (tag mouvant)  -> warn, deploy poursuivi
#   `FROM $BASE` (ARG)             -> warn : l'allowlist ne peut pas s'y appliquer
#   digest changé pour un même tag -> warn : le tag a été réécrit upstream
# Déployer une app basée sur ghcr.io échoue en 422 tant qu'il n'est pas ajouté ici.
HUSKER_ALLOWED_REGISTRIES=docker.io

# Racine des repos git clonés : <root>/<app_id>/ — optionnel (défaut : sources).
HUSKER_SOURCES_ROOT=sources

# Racine des volumes persistants des apps : <root>/<projet>/<app>/data, bind-monté
# sur /data dans le container — optionnel (défaut : data).
HUSKER_DATA_ROOT=data
